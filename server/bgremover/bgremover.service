[Unit]
Description=Background Remover API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/bgremover
Environment=HOME=/root
Environment=OMP_NUM_THREADS=3
ExecStart=/opt/bgremover/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8091 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
