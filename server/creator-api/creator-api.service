[Unit]
Description=Creator Tools API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/creator-api
EnvironmentFile=/etc/creator-api.env
ExecStart=/opt/creator-api/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8092 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
